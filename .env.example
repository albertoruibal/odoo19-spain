# Odoo 19 environment
# Copy this file to .env and fill in real values before running docker compose.
# .env is gitignored and must NEVER be committed.

# PostgreSQL (db service)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# Odoo database name
ODOO_DB=my-odoo-db

# Odoo master/admin password (admin_passwd in odoo.conf, sourced via ODOO_ADMIN_PASSWD)
ADMIN_PASSWORD=change-me-strong-password

# Odoo application user (for in-process maintenance scripts and daily use)
ODOO_USER=user@example.com
ODOO_PASSWORD=change-me-strong-password